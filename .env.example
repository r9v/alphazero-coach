# LLM provider — set ONE of the following:
GOOGLE_API_KEY=your-key-here
# ANTHROPIC_API_KEY=your-key-here

# Optional: override the default model for your provider
# LLM_MODEL=gemini-2.5-flash

# Optional: limit total games per IP/day (0 = unlimited, useful for public demos)
# MAX_GAMES=5

# Optional: limit coach messages per IP/hour (0 = unlimited). Each message is an
# LLM call, so cap this on public demos to protect your API budget.
# MAX_COACH_MSGS=30

# Optional: CORS allowlist (comma-separated). Defaults to localhost + the demo
# domain. The API uses no cookies, so credentials are disabled.
# ALLOWED_ORIGINS=http://localhost:5173,https://alphazero-coach.xyz

# Optional: retrieval pipeline toggles (defaults shown)
# RAG_HYBRID=1        # dense + BM25 fused with RRF
# RAG_RERANK=1        # cross-encoder reranking
# RAG_CONTEXTUAL=1    # contextual-retrieval chunk prefixing
# RAG_HYDE=0          # HyDE query expansion (calls the LLM at query time)

# Optional: Langfuse observability (https://langfuse.com)
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
